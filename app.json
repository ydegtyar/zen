{
  "expo": {
    "name": "Zen",
    "slug": "zen-101",
    "description": "A calm, focused reader for 101 Zen stories.",
    "version": "1.0.0",
    "scheme": "zen",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "orientation": "portrait",
    "icon": "./assets/icons/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ydegtyar.zen",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ydegtyar.zen",
      "versionCode": 1,
      "permissions": [],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/icons/favicon.png"
    },
    "extra": {
      "links": {
        "privacyPolicyUrl": "https://zen-101.vercel.app/privacy",
        "termsOfServiceUrl": "https://zen-101.vercel.app/terms",
        "supportUrl": "https://zen-101.vercel.app/support"
      },
      "router": {},
      "eas": {
        "projectId": "b48846e5-076a-4386-ad12-e36bc0486a81"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-localization",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-screen/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "@react-native-vector-icons/ionicons"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "locales": {
      "en": "./languages/native-en.json",
      "uk": "./languages/native-uk.json",
      "ru": "./languages/native-ru.json"
    },
    "owner": "zen-101"
  }
}
